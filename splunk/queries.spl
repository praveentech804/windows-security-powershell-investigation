/*
Windows Security Log Investigation
Tool: Splunk Enterprise
Index used in this lab: main
Dataset timestamps: 2024-03-04
Select an appropriate time range, such as All time.
Verify field names before relying on any query.
*/

# 1. Event ID overview
index=main
| stats count by event_id
| sort - count

# 2. Failed logon events
index=main event_id=4625
| table _time extracted_host event_id outcome details
| sort 0 _time

# 3. Successful logon events
index=main event_id=4624
| table _time extracted_host event_id outcome details
| sort 0 _time

# 4. Compare failed and successful logon counts by host
index=main (event_id=4624 OR event_id=4625)
| stats count by extracted_host event_id
| sort extracted_host event_id

# 5. Review process creation events
index=main event_id=4688
| table _time extracted_host process_name command_line
| sort 0 _time

# 6. Search PowerShell-related events
index=main
| where lower(process_name)="powershell.exe"
    OR lower(log_channel)="powershell"
    OR like(lower(command_line), "%powershell%")
| table _time extracted_host event_id log_channel process_name command_line details
| sort 0 _time

# 7. Review potentially suspicious command-line patterns
index=main
| eval cmd_lower=lower(coalesce(command_line, ""))
| where like(cmd_lower, "%-encodedcommand%")
    OR like(cmd_lower, "%-enc %")
    OR like(cmd_lower, "%-windowstyle hidden%")
    OR like(cmd_lower, "%downloadstring%")
    OR like(cmd_lower, "%downloadfile%")
    OR like(cmd_lower, "%executionpolicy bypass%")
| table _time extracted_host event_id process_name command_line details
| sort 0 _time

# 8. Review administrative utility execution
index=main event_id=4688
| where lower(process_name)="net.exe"
    OR lower(process_name)="reg.exe"
    OR lower(process_name)="net1.exe"
| table _time extracted_host process_name command_line
| sort 0 _time

# 9. Build a host event timeline
index=main
| table _time extracted_host event_id log_channel process_name command_line outcome details
| sort 0 _time

# 10. Review events with missing event IDs
index=main
| where isnull(event_id) OR event_id=""
| table _time extracted_host log_channel process_name command_line details
| sort 0 _time
