/*
Windows Security & PowerShell investigation SPL
Replace index=windows_investigation with your actual index.
Check field extraction and timestamp parsing before relying on results.
*/

# 1. Overview of event IDs
index=windows_investigation
| stats count by event_id
| sort - count

# 2. Failed logons by source, account, and host
index=windows_investigation event_id=4625
| stats count min(_time) as first_seen max(_time) as last_seen by source_ip user host
| convert ctime(first_seen) ctime(last_seen)
| sort - count

# 3. Burst of failed logons: 3 or more in a 10-minute span
index=windows_investigation event_id=4625
| bin _time span=10m
| stats count by _time source_ip user host
| where count >= 3
| sort - count

# 4. Successful logons
index=windows_investigation event_id=4624
| table _time host user source_ip outcome details
| sort - _time

# 5. PowerShell encoded/hidden/download patterns
index=windows_investigation
| eval cmd_lower=lower(command_line)
| where like(cmd_lower,"% -encodedcommand%")
    OR like(cmd_lower,"% -enc %")
    OR like(cmd_lower,"% -windowstyle hidden%")
    OR like(cmd_lower,"%downloadstring%")
    OR like(cmd_lower,"%downloadfile%")
    OR like(cmd_lower,"%executionpolicy bypass%")
| table _time host user source_ip process_name command_line details
| sort - _time

# 6. Process creation of administrative utilities (review context; not inherently malicious)
index=windows_investigation event_id=4688
| where lower(process_name)="net.exe"
    OR lower(process_name)="net1.exe"
    OR lower(process_name)="reg.exe"
| table _time host user process_name command_line
| sort - _time

# 7. Activity by host and user
index=windows_investigation
| stats count values(event_id) as event_ids values(process_name) as processes by host user
| sort - count

# 8. Timeline for a host (replace SRV-DC01 as needed)
index=windows_investigation host="SRV-DC01"
| table _time event_id log_channel user source_ip process_name command_line outcome details
| sort _time

# 9. Events with missing event IDs (useful for PowerShell script-block rows in this CSV)
index=windows_investigation
| where isnull(event_id) OR event_id=""
| table _time host user log_channel process_name command_line details
| sort _time
